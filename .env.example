# 빌드 중에는 로컬 Gemma 사용 (외부 토큰 0)
LLM_PROVIDER=local

# 로컬 Gemma (llama-cpp-python OpenAI 호환 서버)
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=gemma-4-e4b
LOCAL_API_KEY=not-needed

# 최종 스모크 테스트 시에만 채운다 (토큰 소모 주의)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 인증 (JWT) — 반드시 설정. 미설정 시 auth 사용은 ConfigError(503)로 실패
# 운영에서는 임의의 긴 난수로 교체할 것
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DB (미설정 시 config 기본값 = 프로젝트 data/mall.db 절대경로)
# DATABASE_URL=sqlite:///./data/mall.db
