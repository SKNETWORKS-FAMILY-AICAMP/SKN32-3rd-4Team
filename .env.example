# 빌드 중에는 로컬 Gemma 사용 (외부 토큰 0)
LLM_PROVIDER=local

# 로컬 Gemma (llama-cpp-python OpenAI 호환 서버)
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=gemma-4-e4b
LOCAL_API_KEY=not-needed

# 최종 스모크 테스트 시에만 채운다 (토큰 소모 주의)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 인증 (JWT) — 반드시 설정. 미설정 시 auth 사용은 ConfigError(503)로 실패
# 운영에서는 임의의 긴 난수로 교체할 것
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DB (미설정 시 config 기본값 = 프로젝트 data/db/insurance.sqlite3 절대경로)
# DATABASE_URL=sqlite:///./data/db/insurance.sqlite3

# Hybrid retrieval reranker (disabled until a GPU-backed serving process is ready)
RAG_RERANK_ENABLED=false
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# Low-latency fallback measured on the same S6 candidate set:
RERANKER_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_DTYPE=float16
RERANKER_BATCH_SIZE=1
RERANKER_MAX_LENGTH=768
RERANKER_OVER_FETCH=20
RERANKER_TRUST_REMOTE_CODE=false
