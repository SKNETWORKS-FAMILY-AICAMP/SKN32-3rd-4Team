# 생성물(실행 시 만들어지는 리포트 산출물) — docs/ 이동에 맞춘 경로
docs/generated_reports/

# 사용자 요구사항 원본 — 절대 커밋 금지
# (이전엔 ignore 규칙 없이 add만 안 한 상태라 실수로 커밋될 위험이 있었다 → 명시적 보호)
프로젝트설명.txt
docs/프로젝트설명.txt

# 작업 규칙 문서(로컬 전용)
RULE.md

# 워크스페이스 루트 .gitignore의 `**/plans/`·`**/reports/` 규칙이 이 프로젝트의
# docs/ 하위까지 잡아가므로, 문서 폴더는 명시적으로 되살린다(추적 대상).
!docs/plans/
!docs/history/
!docs/reports/

# 파인튜닝 생성물(분할·평가 결과) — 재생성 가능
data/finetune/

# 사용자 개인 기획 자료(ChatGPT 대화 내보내기 등) — 공개 레포에 올리지 않는다.
# 대화 사이드바에 다른 프로젝트명 등 무관한 개인정보가 함께 담기므로 추적 제외한다.
docs/my_idea*.mhtml
*.mhtml

# 수집한 보험약관 원문 — 저작물이므로 저장소에 커밋하지 않는다(권리 확인 없는 재배포 금지).
# 커밋되는 것은 메타데이터(fetch_manifest.jsonl)뿐이며, 원문은 각자 재수집한다.
data/raw/insurance_terms/

# ─────────────────────────────────────────────────────────────
# 약관 파생물 — ★원문과 같은 저작물이다
#
# PDF 는 data/raw/insurance_terms/ 로 막아 뒀는데, 그것을 텍스트로 뽑은
# 산출물은 안 막고 있었다. 형식만 바뀌었을 뿐 **내용은 약관 원문 그대로**다.
#   data/structured/.../02aaee47b190.clauses.json
#     "text": "제95조의 2) '중요한 내용'이란 보험료와 보장범위, 보험금 지급사유…"
# 공개 저장소에 올리면 12개사 약관 전문을 재배포하는 것이 된다.
# (CLAUDE.md §2 — "약관 원문은 저작물이다. data/raw/ 에만 두고 커밋하지 않는다")
data/extracted/
data/structured/
data/raw/excluded/

# 레거시 보관소 — 압축본이고 현행 프로젝트와 무관하다.
# 로컬에만 두고 저장소에는 올리지 않는다(ARCH-004 가 참조 금지를 강제한다).
legacy/

# 외부 에이전트 보고 — 개인정보가 섞일 수 있다. 저장소에 올리지 않는다.
data/external/
# 코호트 이벤트 — 실제 청구 결과. 같은 이유.
data/cohort/

# 임시 측정 출력 — 실수로 커밋돼 있었다.
_cov.txt
_gap.txt

# 용어 정의 구절 색인 — 약관 원문 조각이다. 저작물이므로 커밋하지 않는다.
data/glossary/

# 임베딩 평가셋 — 약관 원문 조각이다. 결과 지표만 커밋한다.
data/eval/embed_bench.json

# handoff 계약의 반출용 동결본(zip) — ★백업이 아니다.
# 권위 있는 이력은 git 커밋이고, 이 zip 은 거기서 언제든 다시 만들 수 있다:
#   git archive --format=zip -o out.zip <커밋> docs/handoff/
# 폴더째 막지 않고 zip·manifest 만 좁게 제외한다 — 폴더 ignore 는 압축 해제본이나
# 실수로 만든 파일까지 git status 에서 숨겨 버린다(코덱스 지적).
# ★압축을 풀어 저장소 안에 두지 마라. 검색·IDE·AI 가 구버전을 현행 계약으로 읽는다.
/backups/handoff/*.zip
/backups/handoff/*.manifest.txt

# ★약관 원문이 든 산출물은 커밋하지 않는다(CLAUDE.md §2 — 저작물).
#   `data/exports/s5_clauses.parquet` 은 조항 211,131행 전체와 `text` 열을
#   담고 있어 **팀 저장소에 올라갔다.** git add -A 로 쓸어 담은 실수다.
#   같은 폴더의 나머지 산출물은 메타데이터만이라 남겨 둔다(전수 확인함).
data/exports/*_clauses.parquet
data/exports/**/*_clauses.parquet
